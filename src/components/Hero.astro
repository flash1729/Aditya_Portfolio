---
---

<section class="hero">
    <div class="hero-content">
        <div class="hero-id">
            <div class="photo">
                <span class="blob"></span>
                <img src="/pfp.jpg" alt="aditya medhane" draggable="false" />
            </div>
            <div class="hero-name">
                <h1>aditya<br />medhane</h1>
                <div class="hero-tags">builder · student · open source</div>
            </div>
        </div>
        <p class="tagline">
            i ship software. from apps to compilers. these days i'm landing patches in
            <span class="tag-accent">LLVM</span> and <span class="tag-accent">Clang</span>.
        </p>
        <p class="hero-sub">final-year cse @ iiitm gwalior</p>
    </div>

    <div class="hero-card" aria-hidden="true">
        <div class="card-bar">
            <span class="dot dot-r"></span>
            <span class="dot dot-y"></span>
            <span class="dot dot-g"></span>
            <span class="card-title">aditya.cpp</span>
        </div>
        <pre class="card-body"><code><span class="c-com">// ∞ harry potter rereads</span>
<span class="c-key">struct</span> <span class="c-fn">aditya</span> &#123;
  works_on = <span class="c-str">"clang diagnostics"</span>;
  plays    = <span class="c-str">"tabla, football"</span>;
  wants    = <span class="c-str">"friends worldwide"</span>;
&#125;;<span class="cursor"></span></code></pre>
    </div>
</section>

<style>
    .hero { display: flex; justify-content: space-between; align-items: center; margin-bottom: 88px; gap: 48px; }
    .hero-content { flex: 1; min-width: 0; }

    .hero-id { display: flex; align-items: center; gap: 18px; margin-bottom: 22px; }
    .photo { position: relative; width: 96px; height: 96px; flex-shrink: 0; }
    .blob {
        position: absolute; inset: -6px -9px 5px -6px;
        border-radius: 46% 54% 60% 40% / 50% 40% 60% 50%;
        background: var(--accent); opacity: 0.9; transform: rotate(-8deg);
    }
    .photo img {
        position: relative; width: 100%; height: 100%; object-fit: cover;
        border-radius: 40% 60% 55% 45% / 55% 45% 55% 45%;
    }
    .hero-name { min-width: 0; }
    .hero-content h1 { font-size: 2.6rem; font-weight: 800; letter-spacing: -0.045em; line-height: 0.98; }
    .hero-tags {
        margin-top: 8px; font-family: var(--font-mono); font-size: 0.68rem;
        letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted);
    }

    .tagline { font-size: 1.08rem; color: var(--text-secondary); max-width: 30rem; line-height: 1.6; font-weight: 500; letter-spacing: -0.01em; }
    .tag-accent { font-family: var(--font-mono); font-size: 0.92em; color: var(--accent); font-weight: 700; }
    .hero-sub { margin-top: 10px; font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-muted); }

    /* Terminal card */
    .hero-card {
        flex-shrink: 0; width: 320px; max-width: 100%;
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 16px; background: #0e0e11; overflow: hidden;
        box-shadow: 0 30px 60px -30px var(--accent-glow), 0 12px 40px -20px rgba(0, 0, 0, 0.6);
    }
    .card-bar {
        display: flex; align-items: center; gap: 7px; padding: 10px 14px;
        background: #16161a; border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }
    .dot { width: 11px; height: 11px; border-radius: 50%; }
    .dot-r { background: #ff5f56; }
    .dot-y { background: #ffbd2e; }
    .dot-g { background: #27c93f; }
    .card-title { margin-left: 8px; font-family: var(--font-mono); font-size: 0.72rem; color: #6b6b76; }
    .card-body {
        margin: 0; padding: 18px 18px 20px;
        font-family: var(--font-mono); font-size: 0.78rem; line-height: 1.7; color: #e8e4dc; overflow-x: auto;
    }
    .c-com { color: #5f5f6a; }
    .c-key { color: #ff8a5b; font-weight: 700; }
    .c-fn { color: #ffd166; }
    .c-str { color: #9be0c8; }
    .cursor {
        display: inline-block; width: 8px; height: 1em; background: #ff8a5b;
        margin-left: 2px; vertical-align: text-bottom; animation: blink 1.1s steps(1) infinite;
    }
    @keyframes blink { 0%, 50% { opacity: 1; } 50.01%, 100% { opacity: 0; } }

    @media (max-width: 720px) {
        .hero { flex-direction: column; align-items: flex-start; gap: 36px; margin-bottom: 64px; }
        .hero-content h1 { font-size: 2.2rem; }
        .photo { width: 80px; height: 80px; }
        .hero-card { width: 100%; }
    }
</style>
